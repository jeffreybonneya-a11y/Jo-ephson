rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: bundles
    // Fields: name (string), dataAmount (string), price (number), network (string), active (bool), externalPlanId (string, optional)
    //
    // Collection: orders
    // Fields: customerPhone (string), customerNetwork (string), bundleId (string), 
    //         bundleName (string), price (number), status (string), 
    //         paymentMethod (string), transactionId (string), createdAt (timestamp),
    //         externalOrderId (string, optional), externalResponse (string, optional)
    //
    // Collection: users
    // Fields: email (string), role (string)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return isAuthenticated() && ("email" in request.auth.token) ? request.auth.token.email : "";
    }

    function isAdmin() {
      return isAuthenticated() && (
             ("email" in request.auth.token && (
               (request.auth.token.email.lower() == "kingjdeals@gmail.com") ||
               (request.auth.token.email.lower() == "jeffreybonneya@gmail.com") ||
               (request.auth.token.email.lower() == "emmagyapong62@gmail.com")
             ))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.matches("^[^@]+@[^@]+\\.[^@]+$");
    }

    function isValidPhone(phone) {
      return phone is string && phone.size() >= 10 && phone.size() <= 15;
    }

    // Domain Validators
    function isValidBundle(data) {
      return data.keys().hasAll(['name', 'dataAmount', 'price', 'network']) &&
             data.name is string && data.name.size() < 200 &&
             data.dataAmount is string && data.dataAmount.size() < 100 &&
             data.price is number && data.price > 0 &&
             data.network in ['MTN', 'Telecel', 'AirtelTigo', 'FC Mobile', 'FC Mobile Points', 'FC Mobile Silver'] &&
             (!('externalPlanId' in data) || data.externalPlanId == null || data.externalPlanId is string) &&
             (!('category' in data) || data.category is string);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['email', 'phone', 'network', 'bundle', 'amount', 'status', 'createdAt']) &&
             isValidEmail(data.email) &&
             data.phone is string &&
             data.network is string &&
             data.bundle is string &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['paid', 'completed', 'failed', 'pending', 'processing', 'delivered', 'pending_payment', 'unpaid', 'accepted', 'declined', 'checkout_unpaid', 'success', 'pending_verification'] &&
             data.createdAt is timestamp &&
             (!('reference' in data) || data.reference is string) &&
             (!('userId' in data) || data.userId is string) &&
             (!('customerName' in data) || data.customerName is string) &&
             (!('paymentStatus' in data) || data.paymentStatus is string) &&
             (!('paymentMethod' in data) || data.paymentMethod is string) &&
             (!('payment_provider' in data) || data.payment_provider is string) &&
             (!('examType' in data) || data.examType is string) &&
             (!('quantity' in data) || data.quantity is number) &&
             (!('serviceType' in data) || data.serviceType is string) &&
             (!('customerPhone' in data) || data.customerPhone is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('deliveryNotes' in data) || data.deliveryNotes is string) &&
             (!('adminNotes' in data) || data.adminNotes is string) &&
             (!('voucherCode' in data) || data.voucherCode is string) &&
             (!('pin' in data) || data.pin is string) &&
             (!('serialNumber' in data) || data.serialNumber is string) &&
             (!('serial' in data) || data.serial is string) &&
             (!('fulfilledAt' in data) || data.fulfilledAt is timestamp) &&
             (!('fulfilledBy' in data) || data.fulfilledBy is string) &&
             (!('paymentReference' in data) || data.paymentReference is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('id' in data) || data.id is string) &&
             (!('type' in data) || data.type in ['data', 'stream', 'system']) &&
             (!('streamType' in data) || data.streamType in ['live', 'onetime']) &&
             (!('streamStatus' in data) || data.streamStatus in ['pending', 'pending_approval', 'approved', 'rejected']) &&
             (!('metadata' in data) || data.metadata is map) &&
             (!('agentId' in data) || data.agentId is string) &&
             (!('agent_id' in data) || data.agent_id is string) &&
             (!('agentName' in data) || data.agentName is string) &&
             (!('agent_name' in data) || data.agent_name is string) &&
             (!('wholesalePrice' in data) || data.wholesalePrice is number) &&
             (!('wholesale_price' in data) || data.wholesale_price is number) &&
             (!('agentPrice' in data) || data.agentPrice is number) &&
             (!('agent_price' in data) || data.agent_price is number) &&
             (!('profit' in data) || data.profit is number) &&
             (!('agent_profit' in data) || data.agent_profit is number) &&
             (!('profitAwarded' in data) || data.profitAwarded is bool) &&
             (!('profit_credited' in data) || data.profit_credited is bool) &&
             (!('reportedToAdmin' in data) || data.reportedToAdmin is bool) &&
             (!('agentReportReason' in data) || data.agentReportReason is string) &&
             (!('recipientUsername' in data) || data.recipientUsername is string) &&
             (!('fcUserId' in data) || data.fcUserId is string) &&
             (!('fcUsername' in data) || data.fcUsername is string) &&
             (!('momoRefCode' in data) || data.momoRefCode is string) &&
             (!('momoNumber' in data) || data.momoNumber is string) &&
             (!('isAgentOrder' in data) || data.isAgentOrder is bool) &&
             (!('momoSentClicked' in data) || data.momoSentClicked is bool) &&
             (!('userConfirmedAt' in data) || data.userConfirmedAt is timestamp);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName', 'role']) &&
             isValidEmail(data.email) &&
             data.fullName is string && data.fullName.size() > 0 &&
             data.role in ['admin', 'user'] &&
             (!('phoneNumber' in data) || data.phoneNumber == null || data.phoneNumber == "" || isValidPhone(data.phoneNumber)) &&
             (!('walletBalance' in data) || data.walletBalance is number) &&
             (!('isAgent' in data) || data.isAgent is bool) &&
             (!('uid' in data) || data.uid is string) &&
             (!('id' in data) || data.id is string) &&
             (!('gmail' in data) || data.gmail is string) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('username' in data) || data.username is string) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('topupReference' in data) || data.topupReference is string) &&
             (!('authProvider' in data) || data.authProvider is string) &&
             (!('providerId' in data) || data.providerId is string) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is timestamp || data.lastLoginAt is string) &&
             (!('lastSignInTime' in data) || data.lastSignInTime is timestamp || data.lastSignInTime is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    function isValidAgent(data) {
      return data.keys().hasAll(['id', 'agent_name', 'agent_slug', 'momo_name', 'momo_number', 'profit_balance', 'created_at']) &&
             data.id is string &&
             data.agent_name is string && data.agent_name.size() > 0 && data.agent_name.size() < 100 &&
             data.agent_slug is string && data.agent_slug.size() > 0 && data.agent_slug.size() < 100 &&
             data.momo_name is string && data.momo_name.size() > 0 && data.momo_name.size() < 100 &&
             data.momo_number is string && data.momo_number.size() >= 10 && data.momo_number.size() <= 15 &&
             data.profit_balance is number &&
             data.created_at is timestamp &&
             (!('prices' in data) || data.prices is map);
    }

    function isValidAgentOrder(data) {
      return data.keys().hasAll(['id', 'agent_id', 'customer_details', 'wholesale_price', 'agent_price', 'profit', 'status', 'created_at']) &&
             data.id is string &&
             data.agent_id is string &&
             data.customer_details is map &&
             data.wholesale_price is number && data.wholesale_price >= 0 &&
             data.agent_price is number && data.agent_price >= 0 &&
             data.profit is number &&
             data.status is string &&
             data.created_at is timestamp &&
             (!('paymentReference' in data) || data.paymentReference is string);
    }

    function isValidProfitRequest(data) {
      return data.keys().hasAll(['agent_id', 'withdrawal_amount', 'status', 'created_at']) &&
             data.agent_id is string &&
             data.withdrawal_amount is number && data.withdrawal_amount > 0 &&
             data.status in ['pending', 'Seen'] &&
             data.created_at is timestamp &&
             (!('agent_name' in data) || data.agent_name is string) &&
             (!('momo_name' in data) || data.momo_name is string) &&
             (!('momo_number' in data) || data.momo_number is string);
    }

    function isValidClientUserUpdate(incoming, existing) {
       return (!('role' in incoming) || incoming.role == existing.role) &&
              (!('walletBalance' in incoming) || incoming.walletBalance <= existing.get('walletBalance', 0));
    }

    function isValidComplaint(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'message', 'status', 'createdAt']) &&
             data.userId is string &&
             isValidEmail(data.userEmail) &&
             data.message is string && data.message.size() > 0 && data.message.size() < 1000 &&
             data.status in ['open', 'resolved'] &&
             data.createdAt is timestamp &&
             (!('orderId' in data) || data.orderId is string) &&
             (!('subject' in data) || data.subject is string) &&
             (!('userName' in data) || data.userName is string) &&
             (!('adminReply' in data) || data.adminReply is string);
    }

    function isValidWalletTransaction(data) {
      return data.keys().hasAll(['userId', 'amount', 'type', 'status', 'reference', 'createdAt']) &&
             data.userId is string &&
             data.amount is number && data.amount > 0 &&
             data.type in ['topup', 'purchase'] &&
             data.status in ['pending', 'success', 'failed'] &&
             data.reference is string &&
             data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'userName', 'message', 'status', 'createdAt']) &&
             data.userId is string &&
             isValidEmail(data.userEmail) &&
             data.userName is string && data.userName.size() > 0 &&
             data.message is string && data.message.size() > 0 &&
             data.status in ['unread', 'read'] &&
             data.createdAt is timestamp &&
             (!('subject' in data) || (data.subject is string && data.subject.size() < 100));
    }

    function isValidStreamAccess(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'status', 'referenceCode', 'amountPaid', 'createdAt']) &&
             data.userId is string &&
             data.userName is string &&
             isValidEmail(data.userEmail) &&
             data.status in ['pending', 'approved', 'revoked'] &&
             data.referenceCode is string &&
             data.amountPaid is number &&
             data.createdAt is timestamp;
    }

    // Rules
    match /bundles/{bundleId} {
      allow read: if true; // Public store catalog
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Admins can read all orders; authenticated users can read their own orders or agent orders
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.email == request.auth.token.email || 
        resource.data.agentId == request.auth.uid
      ));
      // Direct client-side order creation is disabled; all orders must be created via POST /api/orders/create using Firebase Admin SDK
      allow create: if false;
      // Client can only update user confirmation flags on pending orders; cannot alter amount, status, or userId
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['momoSentClicked', 'userConfirmedAt', 'momoTransactionId']) && 
        resource.data.status in ['pending', 'pending_verification']
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      // Authenticated users can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can create their own profile, but cannot assign themselves admin role
      allow create: if isAuthenticated() && request.auth.uid == userId && 
                    isValidUser(request.resource.data) &&
                    ((request.resource.data.role == 'user') || (request.resource.data.role == 'admin' && isAdmin()));
      // Users can update their own profile, but cannot escalate to admin or inflate walletBalance
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && isValidClientUserUpdate(request.resource.data, resource.data))
      );
      allow delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidComplaint(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && 
                    request.resource.data.status == 'pending' && 
                    isValidWalletTransaction(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /streamAccess/{accessId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isValidStreamAccess(request.resource.data) && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /agents/{agentId} {
      // Protected: Only admin or the agent owner can read the private details (momo_number, profit_balance)
      // Public storefront customers read sanitized details via /api/agent-store/:slug
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == agentId);
      // Direct client-side agent creation is disabled; agent records can only be created via backend admin / Admin SDK workflow
      allow create: if false;
      // Agent owner can update profile info, but can never modify their profit_balance
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == agentId && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agent_name', 'momo_name', 'momo_number', 'prices']) && 
        request.resource.data.profit_balance == resource.data.profit_balance
      );
      allow delete: if isAdmin();
    }

    match /agent_orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.agent_id == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.status in ['pending', 'pending_verification']);
      allow update, delete: if isAdmin();
    }

    match /profit_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.agent_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.agent_id == request.auth.uid && 
                    request.resource.data.status == 'pending' && 
                    isValidProfitRequest(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true; // Public configuration (announcement, fast delivery, charges, etc.)
      allow write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.referrerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /booking_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /booking_code_purchases/{purchaseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /booking_code_orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /app_downloads/{downloadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /efootballProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /efootballOrders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.status in ['pending', 'PAYMENT_PENDING']);
      allow update, delete: if isAdmin();
    }
  }
}
